# Discord Bot Token\nTOKEN=your_bot_token_here\n\n# Bot Configuration\nCLIENT_ID=your_client_id_here\nGUILD_ID=your_guild_id_here\n\n# MongoDB Connection\nMONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jaber_bot\n\n# Bot Settings\nPREFIX=!\nNODE_ENV=development\n\n# Support Channel IDs (comma-separated)\nSUPPORT_CHANNEL_ID=\nTICKET_CATEGORY_ID=\n\n# Moderation\nLOG_CHANNEL_ID=\nMOD_ROLE_ID=\n\n# Feature Flags\nENABLE_ANTI_SPAM=true\nENABLE_ANTI_LINKS=true\nENABLE_ANTI_RAID=true\nENABLE_AUTO_ROLE=true\nENABLE_WELCOME=true\nENABLE_TICKETS=true\n\n# Thresholds\nSPAM_MESSAGE_THRESHOLD=5\nSPAM_TIME_WINDOW=5000\nRAID_THRESHOLD=10\nRAID_TIME_WINDOW=10000\n